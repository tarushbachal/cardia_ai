# ─────────────────────────────────────────────────────────────────────────────
# Cardia AI — environment template. Copy to `.env.local` and fill in.
#
# Phase 1 runs WITHOUT any of these set (server persistence is OFF and the
# assessment never leaves the browser). They are the ready-to-flip configuration
# the Phase 2 data-access layer reads. See README "Deploy runbook".
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the client. Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Feature flags (Phase 1 defaults shown). Flip to "true" in Phase 2 to turn on
# account-based server persistence.
NEXT_PUBLIC_PERSISTENCE_ENABLED=false

# Anthropic — Phase 2 AI explanation layer (Claude Sonnet). Unused in Phase 1.
ANTHROPIC_API_KEY=
