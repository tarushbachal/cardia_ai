# ─────────────────────────────────────────────────────────────────────────────
# Cardia AI — environment template. Copy to `.env.local` and fill in.
#
# Phase 1 runs WITHOUT any of these set (server persistence is OFF and the
# assessment never leaves the browser). They are the ready-to-flip configuration
# the Phase 2 data-access layer reads. See README "Deploy runbook".
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — from Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the client. Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Feature flags (Phase 1 defaults shown). Flip to "true" in Phase 2 to turn on
# account-based server persistence.
NEXT_PUBLIC_PERSISTENCE_ENABLED=false

# Phase 2.1 — anonymous encrypted capture. Set to "true" (and fill the Supabase
# vars above + ENCRYPTION_KEY below, and apply the assessments migration) to store
# an anonymous, encrypted copy of each assessment for analysis. Also flips the
# privacy copy from "nothing leaves your browser" to "anonymous & encrypted".
NEXT_PUBLIC_CAPTURE_ENABLED=false

# 32-byte AES-256 key, base64-encoded. Generate with:  openssl rand -base64 32
# Server-only — do NOT prefix with NEXT_PUBLIC_. Back this up: if it is lost, the
# encrypted values become unrecoverable (the de-identified columns still work).
ENCRYPTION_KEY=

# Anthropic — Phase 2 AI explanation layer (Claude Sonnet). Unused in Phase 1.
ANTHROPIC_API_KEY=

# Stripe (Phase: billing). Publishable key is public; secret + webhook are server-only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
